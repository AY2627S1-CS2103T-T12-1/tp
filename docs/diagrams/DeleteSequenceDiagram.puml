@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":HireBaseParser" as HireBaseParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "hb:HireBase" as HireBase MODEL_COLOR
end box

[-> LogicManager : execute("delete candidate 1")
activate LogicManager

LogicManager -> HireBaseParser : parseCommand("delete candidate 1")
activate HireBaseParser

create DeleteCommandParser
HireBaseParser -> DeleteCommandParser
activate DeleteCommandParser

DeleteCommandParser --> HireBaseParser
deactivate DeleteCommandParser

HireBaseParser -> DeleteCommandParser : parse("candidate 1")
activate DeleteCommandParser

create DeleteCommand
DeleteCommandParser -> DeleteCommand : DeleteCommand(targetId)
activate DeleteCommand

DeleteCommand --> DeleteCommandParser :
deactivate DeleteCommand

DeleteCommandParser --> HireBaseParser : d
deactivate DeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteCommandParser -[hidden]-> HireBaseParser
destroy DeleteCommandParser

HireBaseParser --> LogicManager : d
deactivate HireBaseParser

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getHireBase()
activate Model
Model --> DeleteCommand : hb
deactivate Model

DeleteCommand -> HireBase : getPersonByCandidateId(targetId)
activate HireBase
HireBase --> DeleteCommand : personToDelete
deactivate HireBase

DeleteCommand -> Model : deletePerson(personToDelete)
activate Model

Model --> DeleteCommand
deactivate Model

create CommandResult
DeleteCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteCommand
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

[<--LogicManager
deactivate LogicManager
@enduml
