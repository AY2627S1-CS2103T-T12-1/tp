@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package "Candidate classes" <<Rectangle>>{
Class Person
Class CandidateId {
    -value : int
}
Class Name
Class Phone
Class Email
Class Address
Class Note
Class Skill
Class Role
Class "<<enumeration>>\nInterviewStage" as InterviewStage
Class PriorityScore {
    -value : int
}
Class Tag
}

show CandidateId fields
show PriorityScore fields

Class HiddenOutside #FFFFFF
HiddenOutside ..> Person

Person *--> "0..1" CandidateId
Person *--> "1" Name
Person *--> "1" Phone
Person *--> "1" Email
Person *--> "1" Address
Person *--> "1" Note
Person *--> "*" Skill
Person *--> "0..1" Role
Person *--> "1" InterviewStage
Person *--> "1" PriorityScore
Person *--> "*" Tag
@enduml
