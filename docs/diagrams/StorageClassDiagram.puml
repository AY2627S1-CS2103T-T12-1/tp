@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "HireBase Storage" #F4F6F6{
Class JsonHireBaseStorage
Class JsonSerializableHireBase {
    -nextCandidateId : Integer
}
Class JsonAdaptedPerson {
    -candidateId : Integer
}
Class JsonAdaptedJobOpening
Class JsonAdaptedTag
}

}

show JsonSerializableHireBase fields
show JsonAdaptedPerson fields

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonHireBaseStorage

JsonHireBaseStorage ..> JsonSerializableHireBase
JsonSerializableHireBase --> "*" JsonAdaptedPerson
JsonSerializableHireBase --> "*" JsonAdaptedJobOpening
JsonAdaptedPerson --> "*" JsonAdaptedTag

@enduml
