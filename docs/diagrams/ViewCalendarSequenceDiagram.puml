@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":HireBaseParser" as HireBaseParser LOGIC_COLOR
participant ":ViewCommandParser" as ViewCommandParser LOGIC_COLOR
participant ":ViewCalendarCommandParser" as ViewCalendarCommandParser LOGIC_COLOR
participant "v:ViewCalendarCommand" as ViewCalendarCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "o:CalendarViewOptions" as CalendarViewOptions MODEL_COLOR
end box

[-> LogicManager : execute("view calendar period/month")
activate LogicManager

LogicManager -> HireBaseParser : parseCommand("view calendar period/month")
activate HireBaseParser

create ViewCommandParser
HireBaseParser -> ViewCommandParser
activate ViewCommandParser

ViewCommandParser --> HireBaseParser
deactivate ViewCommandParser

HireBaseParser -> ViewCommandParser : parse("calendar period/month")
activate ViewCommandParser

create ViewCalendarCommandParser
ViewCommandParser -> ViewCalendarCommandParser
activate ViewCalendarCommandParser

ViewCalendarCommandParser --> ViewCommandParser
deactivate ViewCalendarCommandParser

ViewCommandParser -> ViewCalendarCommandParser : parse("period/month")
activate ViewCalendarCommandParser

create CalendarViewOptions
ViewCalendarCommandParser -> CalendarViewOptions : CalendarViewOptions(MONTH, false, false)
activate CalendarViewOptions

CalendarViewOptions --> ViewCalendarCommandParser
deactivate CalendarViewOptions

create ViewCalendarCommand
ViewCalendarCommandParser -> ViewCalendarCommand : ViewCalendarCommand(o)
activate ViewCalendarCommand

ViewCalendarCommand --> ViewCalendarCommandParser
deactivate ViewCalendarCommand

ViewCalendarCommandParser --> ViewCommandParser : v
deactivate ViewCalendarCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
ViewCalendarCommandParser -[hidden]-> ViewCommandParser
destroy ViewCalendarCommandParser

ViewCommandParser --> HireBaseParser : v
deactivate ViewCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
ViewCommandParser -[hidden]-> HireBaseParser
destroy ViewCommandParser

HireBaseParser --> LogicManager : v
deactivate HireBaseParser

LogicManager -> ViewCalendarCommand : execute(model)
activate ViewCalendarCommand

create CommandResult
ViewCalendarCommand -> CommandResult : CommandResult("Showing calendar.")
activate CommandResult

CommandResult --> ViewCalendarCommand
deactivate CommandResult

ViewCalendarCommand -> CommandResult : withCalendarViewOptions(o)
activate CommandResult

CommandResult --> ViewCalendarCommand : r
deactivate CommandResult

ViewCalendarCommand --> LogicManager : r
deactivate ViewCalendarCommand

note right of LogicManager
  Returns r without calling
  Storage#saveHireBase(...),
  since viewing changes no data.
end note

[<-- LogicManager : r
deactivate LogicManager
@enduml
