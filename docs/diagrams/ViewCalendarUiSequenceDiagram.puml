@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Ui UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
participant ":CalendarPanel" as CalendarPanel UI_COLOR
participant "recordTabs:TabPane" as TabPane UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

[-> MainWindow : executeCommand("view calendar period/month")
activate MainWindow

MainWindow -> LogicManager : execute("view calendar period/month")
activate LogicManager
LogicManager --> MainWindow : r
deactivate LogicManager

MainWindow -> CommandResult : getListView()
activate CommandResult
CommandResult --> MainWindow : CALENDAR
deactivate CommandResult

MainWindow -> CommandResult : getCalendarViewOptions()
activate CommandResult
CommandResult --> MainWindow : o
deactivate CommandResult

MainWindow -> CalendarPanel : setOptions(o)
activate CalendarPanel
CalendarPanel --> MainWindow
deactivate CalendarPanel

MainWindow -> CalendarPanel : refresh()
activate CalendarPanel
CalendarPanel --> MainWindow
deactivate CalendarPanel

MainWindow -> TabPane : select(calendarTab)
activate TabPane
TabPane --> MainWindow
deactivate TabPane

[<-- MainWindow
deactivate MainWindow
@enduml
