<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" spacing="5" GridPane.columnIndex="0">
      <padding>
        <Insets top="10" right="12" bottom="10" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="candidateId" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="interviewStage" styleClass="stage-badge" />
      </HBox>
      <Label fx:id="priorityScore" styleClass="cell_small_label" wrapText="true" />
      <Label fx:id="role" styleClass="cell_small_label" wrapText="true" />
      <FlowPane fx:id="skills" hgap="4" vgap="4" />
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <Label fx:id="email" styleClass="cell_small_label" text="\$email" />
      <Label fx:id="address" styleClass="cell_small_label" text="\$address" />
      <FlowPane fx:id="tags" />
      <Label fx:id="note" styleClass="cell_small_label" text="\$note" wrapText="true" />
    </VBox>
  </GridPane>
</HBox>
